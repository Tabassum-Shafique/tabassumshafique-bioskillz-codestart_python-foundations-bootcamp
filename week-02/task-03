### T_4 -----------> Character Counter



name = input("Write your name: ")

vowels = 0
digits = 0
spaces = 0

for ch in name.lower():
    if ch in "aeiou":
        vowels += 1
    elif ch.isdigit():
        digits += 1
    elif ch == " ":
        spaces += 1

print(f"Total vowels: {vowels}")
print(f"Total digits: {digits}")
print(f"Total spaces: {spaces}")



### T_5 ------> Your Field (Biology)


dna = input("Enter DNA sequence: ")

dna = dna.upper()

gc_count = 0

for base in dna:
    if base == "G" or base == "C":
        gc_count += 1

gc_content = (gc_count / len(dna)) * 100   # to calculate the GC percentage

print("GC Count:", gc_count)
print("GC Content:", gc_content, "%")



