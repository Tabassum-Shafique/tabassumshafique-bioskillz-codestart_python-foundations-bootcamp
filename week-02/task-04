# EXERCISE 3: TO-DO LIST MANAGER
# ==========================================

tasks = []

while True:
    print("\n--- TO-DO LIST MANAGER ---")
    print("1. Add")
    print("2. Remove")
    print("3. Show")
    print("4. Quit")

    choice = input("Choose: ")

    if choice == "1":
        task = input("Enter task: ")
        tasks.append(task)
        print("Task added!")

    elif choice == "2":
        task = input("Enter task to remove: ")

        if task in tasks:
            tasks.remove(task)
            print("Task removed!")
        else:
            print("Task not found!")

    elif choice == "3":
        if len(tasks) == 0:
            print("No tasks available.")
        else:
            for i, task in enumerate(tasks, start=1):
                print(i, ".", task)

    elif choice == "4":
        print("Goodbye!")
        break

    else:
        print("Invalid choice!")


